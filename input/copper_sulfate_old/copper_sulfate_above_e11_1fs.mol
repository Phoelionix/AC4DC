#ATOMS
Cu 2 
H 20
O 18
S 2


#VOLUME
359.016     // Volume per molecule in Angstrom^3.
99999999         // Length scale of sample in Angstrom. Used for effective escape rate of photo-electrons (assumes surrounded by a void).
none // Spatial boundary shape - options are none, spherical, cylindrical, planar


#PULSE
9200         // Photon energy in eV.
1           // Pulse width in femtoseconds (defined as FWHM for Gaussian pulse).
gaussian       // Pulse shape
4 // sim. timespan in FWHM
2 // sim. timespan before pulse peak in FWHM

#USE_COUNT
true    // active (using count)?
0.1  // Photon density (x10^12 ph.µm-2) (3.5e12 um-2)

#NUMERICAL
1000      // Initial guess for number of time step points for rate equation.
20            // Number of threads in OpenMP.

#DYNAMIC_GRID
N              // Grid regions preset, options are: dismal, low, medium, high, (referring to accuracy),  and no_dirac (static region is used rather than dynamic dirac regions)
0.35            // Grid update period in fs, (dynamic grid only).
0.25            // Time before transforming initial guess grid to dynamic grid in fs. 

#OUTPUT
800         // Number of time steps in the output files.
4000        // number of free-electron grid points in output file.
N            // Write atomic charges in a separate file (Y/N)?
Y            // Write intensity in a separate file (Y/N)?
Y            // Write data for molecular dynamics (MD) in a separate file (Y/N)?

#DEBUG
99 //10     // Simulation cutoff time in fs
0.01    // Interval to update current timestep [fs].
20 // Interval **in steps** between live plot (_live_plot.png) updates
60 // Period between backups in minutes  
####END#####

Notes:
