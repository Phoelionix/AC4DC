data_manager {
  fmodel {
    xray_data {
      r_free_flags {
        test_flag_value = 0
        fraction = 0.05
      }
    }
  }
}
refinement {
  refine {
    strategy = *individual_sites *individual_sites_real_space rigid_body \
               *individual_adp group_adp tls *occupancies group_anomalous den
  }
  main {
    number_of_macro_cycles = 10
    random_seed = None
  }
  modify_start_model {
    modify {
      sites {
        shake = 0.7
      }
    }
  }
  hydrogens {
    refine = individual *riding Auto
  }
}
